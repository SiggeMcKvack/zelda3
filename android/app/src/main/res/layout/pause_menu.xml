<?xml version="1.0" encoding="utf-8"?>
<!-- Content of PauseMenuView. The padding keeps everything inside the TV overscan safe area. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:id="@+id/menu_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="48dp"
        android:paddingVertical="16dp">

        <!-- Tab bar: [L] tabs [R] [x] -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/menu_hint_l"
                style="@style/PauseMenu.KeyBadge"
                android:text="L" />

            <HorizontalScrollView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fillViewport="true"
                android:scrollbars="none">

                <!-- No layout_gravity="center": HorizontalScrollView clips the start of a centered child -->
                <LinearLayout
                    android:id="@+id/menu_tab_strip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <TextView
                android:id="@+id/menu_hint_r"
                style="@style/PauseMenu.KeyBadge"
                android:text="R" />

            <ImageButton
                android:id="@+id/menu_close"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/menu_tab_bg"
                android:contentDescription="Resume"
                android:focusable="false"
                android:src="@drawable/ic_close"
                android:tint="@color/menu_text" />
        </LinearLayout>

        <!-- Breadcrumb for sub-pages (e.g. "Game › Save state") -->
        <TextView
            android:id="@+id/menu_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:paddingHorizontal="20dp"
            android:textColor="@color/menu_text_dim"
            android:textSize="16sp"
            android:visibility="gone" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/menu_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:descendantFocusability="afterDescendants"
                android:paddingVertical="8dp"
                android:scrollbars="none" />

            <ProgressBar
                android:id="@+id/menu_loading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminateTint="@color/menu_focus_bg"
                android:visibility="gone" />
        </FrameLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="8dp"
            android:background="@color/menu_divider" />

        <!-- Footer: restart notice (left), button hints (right) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/menu_restart_notice"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:drawableStart="@drawable/ic_restart"
                android:drawablePadding="8dp"
                android:drawableTint="@color/menu_warning"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:singleLine="true"
                android:text="Restart required for some changes"
                android:textColor="@color/menu_warning"
                android:textSize="14sp"
                android:visibility="invisible" />

            <TextView
                android:id="@+id/menu_hints"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:singleLine="true"
                android:textColor="@color/menu_text_dim"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</merge>
