<?xml version="1.0" encoding="utf-8"?>
<!-- Focus is the primary affordance on TV: a solid, high-contrast fill. -->
<!-- No fade: an exit fade left the old row's green trailing behind the focus (text color
     switches instantly), which read as lag when moving up/down. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/menu_focus_bg" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/menu_pressed_bg" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
